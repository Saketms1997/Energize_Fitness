# Copy to .env (git-ignored) only if you need to override a default.
# Secrets are NOT stored here: database passwords live in Windows Credential Manager
# (created by scripts/setup_database.py).
GYM_DB_HOST=localhost
GYM_DB_PORT=5432
GYM_DB_NAME=gym_management
GYM_DB_APP_USER=gym_app
GYM_DB_MIGRATOR_USER=gym_migrator
GYM_LOG_LEVEL=INFO
# GYM_DATA_DIR=C:\Users\<you>\AppData\Local\GymManagement
# GYM_BACKUP_DIR=D:\GymBackups
